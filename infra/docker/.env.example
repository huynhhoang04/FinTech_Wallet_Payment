# Template for /opt/fintech/infra/docker/.env (chmod 600). Compose interpolation, env_file of
# every service and deploy.sh all read this file.
#   cp infra/docker/.env.example infra/docker/.env
# Generate secrets with: openssl rand -base64 48

# --- Postgres (one instance, five databases created by infra/scripts/init-databases.sql) ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
TX_DB=tx_db
LEDGER_DB=ledger_db
PAYMENT_DB=payment_db
NOTIFICATION_DB=notification_db
AUDIT_DB=audit_db

# --- Redis / Kafka (compose network service names) ---
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP=kafka:9092

# --- Eureka ---
EUREKA_HOST=eureka-server
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me-eureka

# --- Security (all services; base64 for JWT = HMAC-SHA256 key) ---
JWT_SECRET=change-me-jwt-base64-48-bytes
HMAC_SECRET=change-me-hmac
INTERNAL_TOKEN=change-me-internal
ADMIN_PHONES=

# --- Payment provider webhook secrets (payment-gateway-service) ---
VNPAY_SECRET=change-me-vnpay
STRIPE_SECRET=change-me-stripe
VIETQR_SECRET=change-me-vietqr
# MUST stay false in prod - the demo minting endpoints are for local testing only
APP_PAYMENT_DEMO_ENDPOINTS=false

# --- Mail (notification-service; on the VPS mailhog = mailpit container) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@wallet.local
DEMO_RECIPIENT=student@example.com

# --- Ledger endpoints (transaction-engine gRPC, audit REST) ---
LEDGER_GRPC_ADDRESS=account-ledger-service:9090
LEDGER_BASE_URL=http://account-ledger-service:8082

# --- Telegram (CD notify + Alertmanager) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0

# --- Edge / TLS (docker-compose.prod.yml mounts the certbot certs) ---
PUBLIC_DOMAIN=wallet.example.com
CERT_DIR=/etc/letsencrypt

# --- Container memory limits (MaxRAMPercentage=70 inside the JVM) ---
EUREKA_SERVER_MEM=384m
API_GATEWAY_MEM=448m
TRANSACTION_ENGINE_MEM=512m
ACCOUNT_LEDGER_SERVICE_MEM=512m
PAYMENT_GATEWAY_SERVICE_MEM=448m
NOTIFICATION_SERVICE_MEM=320m
AUDIT_SERVICE_MEM=320m
POSTGRES_MEM=512m
REDIS_MEM=192m
KAFKA_MEM=1280m
PROMETHEUS_MEM=384m
GRAFANA_MEM=256m
LOKI_MEM=192m
GRAFANA_PASSWORD=change-me-grafana
