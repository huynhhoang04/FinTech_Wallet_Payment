# ---------- Shared secrets (KHONG commit gia tri that) ----------
# JWT_SECRET: base64, toi thieu 32 byte. Sinh bang: openssl rand -base64 48
JWT_SECRET=
# HMAC_SECRET: secret dung de ky request tu app/merchant
HMAC_SECRET=
# Do lech timestamp cho phep khi verify chu ky (giay)
HMAC_MAX_SKEW_SECONDS=300

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wallet
POSTGRES_PASSWORD=
LEDGER_DB=ledger_db
TX_DB=tx_db
PAYMENT_DB=payment_db
NOTIFICATION_DB=notification_db
AUDIT_DB=audit_db

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Kafka ----------
KAFKA_BOOTSTRAP=localhost:9092

# ---------- Eureka ----------
EUREKA_URI=http://localhost:8761/eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=

# ---------- gRPC ----------
LEDGER_GRPC_HOST=localhost
LEDGER_GRPC_PORT=9090
